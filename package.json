{
  "name": "fem-cabs",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "passenger": "npm run start -w kimu-passenger",
    "driver": "npm run start -w kimu-driver",
    "typecheck": "npm run typecheck -w kimu-passenger && npm run typecheck -w kimu-driver",
    "test:i18n": "node --test \"tests/jev/*.test.mjs\"",
    "test:e2e": "playwright test",
    "build": "cd apps/passenger && expo export --platform web --output-dir ../../dist"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@playwright/test": "^1.63.0"
  }
}
