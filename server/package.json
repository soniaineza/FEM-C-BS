{
  "name": "fem-cabs-server",
  "version": "1.0.0",
  "private": true,
  "description": "Kimu Transport ride-hailing backend (Node + Express + PostgreSQL)",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node src/index.js",
    "db:init": "node src/db.js --init-only",
    "db:check": "node scripts/db-check.js",
    "driver": "node scripts/driver-console.js",
    "docs:move": "node scripts/move-documents-to-store.js",
    "test:doc-store": "node --test test/document-store.test.js",
    "test:sql-compat": "node --test test/sql-compat.test.js",
    "test": "node test/smoke.js && node test/wallet-flow.js",
    "test:smoke": "node test/smoke.js",
    "test:account-flows": "node test/account-flows.js",
    "test:wallet": "node test/wallet-flow.js",
    "test:money": "node test/driver-money.js",
    "test:maps": "node --test test/maps.test.js",
    "test:driver-docs": "node --test test/driver-documents-unit.test.js test/driver-documents.test.js",
    "test:unit": "node --test test/db-unit.test.js test/sql-compat.test.js test/document-store.test.js test/maps.test.js test/otp-whatsapp.test.js test/google-auth.test.js test/driver-documents-unit.test.js",
    "test:otp-whatsapp": "node --test test/otp-whatsapp.test.js",
    "test:otp": "node test/otp-demo.js",
    "test:google-auth": "node --test test/google-auth.test.js",
    "test:google-flow": "node test/google-auth-flow.js",
    "test:whatsapp-login": "node test/whatsapp-login-flow.js",
    "test:email-login": "node test/email-login-flow.js",
    "otp:send-test": "node scripts/send-test-otp.js",
    "test:readiness": "node test/production-readiness.js",
    "test:invariants": "node test/invariants.js",
    "test:places": "node test/jev-place-search.js",
    "test:pair-ride": "node test/pair-ride-flow.js",
    "test:payment-collect": "node test/payment-collect-flow.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.0.16"
  }
}
