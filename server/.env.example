PORT=3000

# Required: a running PostgreSQL server the API connects to.
# For local development: install PostgreSQL, create a database, then:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/femcabs
DATABASE_URL=

# Optional MongoDB URI for the planned data-layer migration. Do not commit
# credentials; put the real value in server/.env.
MONGODB_URI=

# Production: set NODE_ENV=production in deployment. The server REFUSES to
# start unless JWT_SECRET, SMS_PROVIDER (+ its keys), the three PAYPACK_*
# values, EMERGENCY_CALL_CENTER_PHONE and ADMIN_API_KEY are set, and refuses
# DEV_REVEAL_CODES / DEMO_PAYMENTS / DEV_AUTO_VERIFY_DRIVERS.
NODE_ENV=development
# JWT_SECRET=use-a-long-random-string
# JWT_EXPIRES_IN=30d

# OTP behaviour
# OTP_LENGTH=6
# OTP_TTL_SECONDS=300
# OTP_RESEND_COOLDOWN=60
# OTP_MAX_ATTEMPTS=5
# DEV_REVEAL_CODES=0   # set 1 to echo OTP codes in dev responses (NEVER in production)

# Brute-force protection
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=20

# Maps / geocoding (proxied server-side so the app needs no API key)
# Production requires privately hosted or contracted routing and Photon URLs.
# OSRM_URL=https://routing.example.com/route/v1/driving
# PHOTON_URL=https://geocode.example.com/api/
# PHOTON_REVERSE_URL=https://geocode.example.com/reverse
# Optional private Nominatim fallback only; leave unset otherwise.
# NOMINATIM_URL=https://private-nominatim.example.com/search
# NOMINATIM_REVERSE_URL=https://private-nominatim.example.com/reverse
# MAPS_API_KEY=

# Paypack (Rwanda mobile money) — server-side only, never in the app.
# PAYPACK_CLIENT_ID=
# PAYPACK_CLIENT_SECRET=
# PAYPACK_BASE_URL=https://payments.paypack.rw
# Webhook secret from the Paypack dashboard. Register the webhook URL as
# https://<your-api-host>/api/webhooks/paypack
# PAYPACK_WEBHOOK_SECRET=

# Push goes through Expo's push service (services/expoPush.js) and needs no
# server key; FCM credentials are uploaded to EAS for the Android build.

# SMS for OTP delivery. SMS_PROVIDER: pindo | africastalking | generic.
# Unset = codes are only printed in the server log (development only).
# SMS_PROVIDER=pindo
# SMS_API_KEY=            # Pindo token / Africa's Talking API key / generic bearer
# AT_USERNAME=            # Africa's Talking only ('sandbox' for their test env)
# SMS_GATEWAY_URL=        # generic only: receives POST { to, sender, message }
# SMS_SENDER_NAME=KIMU   # must be a sender ID registered with the provider

# Operator key for /api/admin (driver verification). >= 24 random characters,
# e.g. `openssl rand -hex 24`. Unset disables the admin routes.
# ADMIN_API_KEY=

# Driver money: platform commission rate, unpaid cash-trip commission (RWF)
# allowed before a driver must settle to go online, and the minimum payout.
# DRIVER_COMMISSION_RATE=1     # 1 = whole fare to the platform; 0.15 = drivers keep 85%
# DRIVER_MAX_COMMISSION_DEBT=5000
# DRIVER_MIN_PAYOUT=1000
# PAYOUT_FEE_RATE=0.023        # provider cash-out fee, deducted from payouts
# PAYMENT_EXPIRY_SECONDS=180    # unanswered mobile-money prompt counts as failed

# Ride / fare tuning
# ESTIMATE_AVG_SPEED_KMH=25
# RIDE_PIN_LENGTH=4
# TRIP_SHARE_TTL_HOURS=24

# Kimu Transport call center — the number the app's SOS button dials (returned by
# GET /api/emergency/config and POST /api/emergency). Required in
# production; when unset (development) the app hides the call button.
# EMERGENCY_CALL_CENTER_PHONE=

# Dev/demo switches — honoured only when DATABASE_URL is a local database
# (ignored on any hosted database) and refused outright in production.
# DEV_AUTO_VERIFY_DRIVERS=0
# DEV_ALLOW_STALE_DRIVERS=0  # local tests only: match seeded drivers with no live GPS
# DEMO_PAYMENTS=0
# DEMO_FLEET=0             # development only; refused in production
# DEMO_FLEET_SIZE=32       # maximum supported by the bundled simulator roster
# seed-dev-drivers.js requires SEED_DEV_DATA=1, a local database, and your own
# SEED_DRIVER_PASSWORD (12+ characters; there is no built-in default).
# SEED_DEV_DATA=0
# SEED_DRIVER_PASSWORD=

# CORS_ORIGINS=*
