PORT=3000

# Required: a running PostgreSQL server the API connects to.
# For local development: install PostgreSQL, create a database, then:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/femcabs
DATABASE_URL=

# Optional MongoDB URI for the planned data-layer migration. Do not commit
# credentials; put the real value in server/.env.
MONGODB_URI=

# Production cat: set NODE_ENV=production in deployment. The server REFUSES to
# start without JWT_SECRET (and refuses DEV_REVEAL_CODES) when production.
NODE_ENV=development
# JWT_SECRET=use-a-long-random-string
# JWT_EXPIRES_IN=30d

# OTP behaviour
# OTP_LENGTH=6
# OTP_TTL_SECONDS=300
# OTP_RESEND_COOLDOWN=60
# OTP_MAX_ATTEMPTS=5
# DEV_REVEAL_CODES=0   # set 1 to echo OTP codes in dev responses (NEVER in production)

# Brute-force protection
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=20

# Maps / geocoding (proxied server-side so the app needs no API key)
# NOMINATIM_URL=https://nominatim.openstreetmap.org/search
# NOMINATIM_REVERSE_URL=https://nominatim.openstreetmap.org/reverse
# OSRM_URL=https://router.project-osrm.org/route/v1/driving
# MAPS_API_KEY=

# Paypack (Rwanda mobile money) — server-side only, never in the app.
# PAYPACK_CLIENT_ID=
# PAYPACK_CLIENT_SECRET=
# PAYPACK_BASE_URL=https://payments.paypack.rw
# PAYPACK_WEBHOOK_SECRET=

# Firebase Cloud Messaging (push notifications)
# FCM_SERVER_KEY=
# FCM_PROJECT_ID=
# FCM_SENDER_ID=

# SMS gateway for OTP delivery
# SMS_GATEWAY_URL=
# SMS_GATEWAY_API_KEY=
# SMS_SENDER_NAME=FEM CABS

# Ride / fare tuning
# ESTIMATE_AVG_SPEED_KMH=25
# RIDE_PIN_LENGTH=4
# TRIP_SHARE_TTL_HOURS=24

# FEM C@BS call center — the number the app's SOS button dials (returned by
# GET /api/emergency/config and POST /api/emergency). PLACEHOLDER until the
# real call-center number is confirmed; MUST be set in production.
# EMERGENCY_CALL_CENTER_PHONE=+250788000000

# Dev: seed + simulation. seed-dev-drivers.js requires SEED_DEV_DATA=1.
# SEED_DEV_DATA=0
# SIM_ENABLED=1

# CORS_ORIGINS=*