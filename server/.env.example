PORT=3000

# Required: the MySQL (8.0.13+) or MariaDB (10.4+) database the API uses.
# On cPanel: MySQL Database Wizard creates the database and the user, then
# "Add user to database" with ALL PRIVILEGES. cPanel prefixes both names with
# the account name, so use them exactly as the wizard shows them. A database
# on another machine (Render -> cPanel) also needs the API server's address
# allowed under cPanel > Remote Database Access.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
# Remote hosts are connected with TLS by default (certificate not verified,
# since shared hosts use self-signed ones). To verify it, set MYSQL_SSL_CA to
# the CA certificate file. MYSQL_SSL=off disables TLS (only for a database on
# this machine); MYSQL_SSL=on forces it. Shared hosts cap connections per
# account: keep MYSQL_POOL_SIZE well under that limit.
# MYSQL_SSL=
# MYSQL_SSL_CA=
# MYSQL_POOL_SIZE=8

# Developer machine only: LOCAL_DEVELOPMENT=1 (with the database on this
# machine) enables the development switches (DEV_REVEAL_CODES, ...), a
# wildcard CORS_ORIGINS and the lenient fallbacks. NEVER set it on a server,
# even when that server's database is on localhost.
# LOCAL_DEVELOPMENT=1

# Production: set NODE_ENV=production. The server refuses to start unless:
#   - JWT_SECRET
#   - an OTP channel (WhatsApp/SMS/email)
#   - PAYPACK_CLIENT_ID/SECRET/WEBHOOK_SECRET
#   - EMERGENCY_CALL_CENTER_PHONE
#   - ADMIN_USERNAME and ADMIN_PASSWORD (>= 12 chars)
#   - MYSQL_HOST, MYSQL_DATABASE, MYSQL_USER, MYSQL_PASSWORD
NODE_ENV=development
# JWT_SECRET=use-a-long-random-string

# ---- OTP delivery (verification codes for login/signup) ----
# One channel must be configured. Order tried: WhatsApp, then SMS, then e-mail.
# OTP_CHANNEL=whatsapp
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# SMS_PROVIDER=pindo | africastalking | generic
# SMS_API_KEY=
# SMS_SENDER_NAME=KIMU

# ---- Paypack (Rwanda mobile money) ----
# Paypack credentials live server-side only. The webhook URL is
#   https://<your-api-host>/api/webhooks/paypack
# PAYPACK_CLIENT_ID=
# PAYPACK_CLIENT_SECRET=
# PAYPACK_WEBHOOK_SECRET=

# ---- Operator page credentials ----
# ADMIN_USERNAME=choose-an-operator-username
# ADMIN_PASSWORD=choose-a-strong-unique-password (min 12 chars)
# ADMIN_API_KEY=optional, for trusted integrations

# ---- Driver document files ----
# Set both to keep the files on the cPanel host (see doc-store/README.md)
# instead of inside the database. Leave both empty to store them in the database.
# DOCUMENT_STORE_URL=https://kimutransport.com/doc-store/
# DOCUMENT_STORE_TOKEN=the same long secret as in kimu-doc-store-config.php

# ---- SOS ----
# EMERGENCY_CALL_CENTER_PHONE=the-number-the-SOS-button-dials
