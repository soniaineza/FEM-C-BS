# Base URL for the Kimu Transport backend API, inlined into the client bundle at
# build time (Expo requires the EXPO_PUBLIC_ prefix for that). Equivalent to
# the old Flutter app's --dart-define=FEM_BASE_URL.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api

# Number the SOS button dials before the app has ever reached the server (and
# whenever it has no signal). Defaults to 112, Rwanda's national emergency line.
# Set it to your own call centre for release builds.
# EXPO_PUBLIC_EMERGENCY_PHONE=112

# ---------------------------------------------------------------------------
# Standalone (server-free) build — see services/offline/ and README.
# EXPO_PUBLIC_OFFLINE_DEMO=1 makes the app answer every API call on the phone.
#
# Optional: send OTP codes, ride updates and SOS alerts as real SMS through
# Pindo (https://pindo.io) straight from the phone. Leave the token empty and
# the app shows codes on screen instead. Nothing is sent unless the phone is
# online and the token is valid; on any failure the on-screen fallback is used.
#
# SECURITY: EXPO_PUBLIC_* values are compiled into the APK and can be read by
# anyone who has the file. Use a dedicated Pindo token with a small balance for
# builds you hand out, keep it in an untracked .env, never commit it.
# EXPO_PUBLIC_OFFLINE_DEMO=1
#
# Real street routes and traffic when the phone is online. Defaults to the
# public OSRM demo (free, no key, light non-commercial use). Point it at your
# own OSRM (".../route/v1/driving"), or use "off" to keep local curves.
# EXPO_PUBLIC_OSRM_URL=https://router.project-osrm.org/route/v1/driving
# EXPO_PUBLIC_PINDO_TOKEN=
# EXPO_PUBLIC_PINDO_SENDER=FEM CABS        # must be a sender ID registered with Pindo
# EXPO_PUBLIC_PINDO_SMS_EVENTS=otp,sos,ride

# ---------------------------------------------------------------------------
# Twilio (alternative to Pindo, standalone build). Same warning: these are
# compiled into the APK. Use a *Restricted* API key limited to Messages/Verify
# and keep the Twilio account on TRIAL while the APK circulates (a trial
# account can only text numbers you have verified in the console).
#
# OTP codes go through Twilio Verify (Twilio generates, texts and checks them,
# so the app never holds the code). Ride updates and SOS use the Messages API.
# EXPO_PUBLIC_TWILIO_ACCOUNT_SID=AC...
# EXPO_PUBLIC_TWILIO_API_KEY_SID=SK...     # omit if the secret below is the account Auth Token
# EXPO_PUBLIC_TWILIO_SECRET=               # API key secret (or Auth Token)
# EXPO_PUBLIC_TWILIO_VERIFY_SID=VA...      # enables Verify for OTP
# EXPO_PUBLIC_TWILIO_FROM=+1...            # number / MG... service; enables ride + SOS texts
# EXPO_PUBLIC_SMS_PROVIDER=pindo           # pindo | twilio, when both are configured
# EXPO_PUBLIC_SMS_EVENTS=otp,sos,ride
