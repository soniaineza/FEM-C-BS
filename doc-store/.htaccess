# Kimu document store — Apache settings for cPanel.

Options -Indexes
DirectoryIndex index.php

# Only index.php is reachable; nothing else in this folder is served.
<FilesMatch "^(?!index\.php$).*$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

# Keep the store's answers out of every cache.
<IfModule mod_headers.c>
  Header always set Cache-Control "no-store"
  Header always set X-Content-Type-Options "nosniff"
</IfModule>
